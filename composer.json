{
  "name": "wp-ai-os/wp-ai-os",
  "description": "Enterprise-grade AI Operating System for WordPress extending Agent Abilities for MCP.",
  "version": "1.0.0",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Lead WordPress AI Platform Engineer",
      "email": "architecture@wp-ai-os.io"
    }
  ],
  "require": {
    "php": ">=8.2",
    "psr/container": "^2.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "friendsofphp/php-cs-fixer": "^3.50",
    "infection/infection": "^0.28",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan": "^1.11",
    "phpstan/phpstan-strict-rules": "^1.6",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.9",
    "vimeo/psalm": "^5.23 || ^6.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "WPAIOS\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WPAIOS\\Tests\\": "tests/"
    },
    "files": [
      "stubs/wordpress-stubs.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "infection/extension-installer": true
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "test:coverage": "phpunit --configuration=phpunit.xml.dist --coverage-text",
    "test:mutation": "infection --configuration=infection.json.dist --min-msi=80",
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist",
    "psalm": "psalm --config=psalm.xml",
    "lint": "phpcs --standard=phpcs.xml.dist",
    "lint:fix": "phpcbf --standard=phpcs.xml.dist",
    "format": "php-cs-fixer fix --config=.php-cs-fixer.php",
    "format:check": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
    "audit": "composer audit",
    "quality-gate": [
      "@audit",
      "@lint",
      "@format:check",
      "@phpstan",
      "@psalm",
      "@test:coverage",
      "@test:mutation"
    ]
  }
}
